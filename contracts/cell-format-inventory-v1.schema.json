{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seoan:contracts:cell-format-inventory-v1",
  "title": "Seoan HLT bounded table-cell character format inventory page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source", "source_sha256", "cell_count", "formatted_span_count",
    "unresolved_count", "cursor", "limit", "next_cursor", "has_more", "items"
  ],
  "properties": {
    "source": {"$ref": "#/$defs/fileName"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "cell_count": {"$ref": "#/$defs/decimal"},
    "formatted_span_count": {"$ref": "#/$defs/decimal"},
    "unresolved_count": {"$ref": "#/$defs/decimal"},
    "cursor": {"$ref": "#/$defs/decimal"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "next_cursor": {
      "oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]
    },
    "has_more": {"type": "boolean"},
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/span"}
    }
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "fileName": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "format": {"enum": ["underline", "bold", "italic", "superscript", "subscript"]},
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "table_id", "start", "end", "raw_code", "raw_attr", "formats"],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^cell:[0-9]+:[0-9]+:[0-9]+$", "maxLength": 128},
        "table_id": {"type": "string", "pattern": "^table:[0-9]+$", "maxLength": 128},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "raw_code": {"type": "integer", "minimum": 0},
        "raw_attr": {"type": "integer", "minimum": 1},
        "formats": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/format"}}
      }
    }
  }
}
