{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seoan:contracts:document-v1",
  "title": "Seoan HLT Phase 1 verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "file_size",
    "input_sha256",
    "header_ok",
    "magic_ok",
    "header_len",
    "stream_start",
    "stream_end",
    "footer_offset",
    "footer_crc",
    "computed_crc",
    "footer_size",
    "computed_size",
    "footer_crc_ok",
    "footer_size_ok",
    "inflate_ok",
    "inflated",
    "compressed_bytes",
    "window_ok",
    "first_block"
  ],
  "properties": {
    "source": { "type": "string" },
    "file_size": { "$ref": "#/$defs/decimal" },
    "input_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "header_ok": { "type": "boolean" },
    "magic_ok": { "type": "boolean" },
    "header_len": { "$ref": "#/$defs/decimal" },
    "stream_start": { "$ref": "#/$defs/decimal" },
    "stream_end": { "$ref": "#/$defs/decimal" },
    "footer_offset": { "$ref": "#/$defs/decimal" },
    "footer_crc": { "$ref": "#/$defs/decimal" },
    "computed_crc": { "$ref": "#/$defs/decimal" },
    "footer_size": { "$ref": "#/$defs/decimal" },
    "computed_size": { "$ref": "#/$defs/decimal" },
    "footer_crc_ok": { "type": "boolean" },
    "footer_size_ok": { "type": "boolean" },
    "inflate_ok": { "type": "boolean" },
    "inflated": { "$ref": "#/$defs/decimal" },
    "compressed_bytes": { "$ref": "#/$defs/decimal" },
    "window_ok": { "type": "boolean" },
    "window_proof": { "oneOf": [{ "const": "first_block" }, { "const": "stored" }, { "type": "object", "additionalProperties": false, "required": ["decoded"], "properties": {"decoded": {"type": "object", "additionalProperties": false, "required": ["max_distance"], "properties": {"max_distance": {"type": "integer", "minimum": 0, "maximum": 4096}}}} }] },
    "first_block": { "$ref": "#/$defs/firstBlock" }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^[0-9]+$" },
    "firstBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_block", "kind", "hlit", "hdist", "hclen", "window_ok"],
      "properties": {
        "final_block": { "type": "boolean" },
        "kind": { "enum": ["stored", "fixed", "dynamic"] },
        "hlit": { "type": ["integer", "null"], "minimum": 0 },
        "hdist": { "type": ["integer", "null"], "minimum": 0 },
        "hclen": { "type": ["integer", "null"], "minimum": 0 },
        "window_ok": { "type": "boolean" }
      }
    }
  }
}
