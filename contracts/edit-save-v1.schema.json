{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seoan:contracts:edit-save-v1",
  "title": "Seoan HLT exact text edit save result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_source", "output_source", "input_file_size", "output_file_size",
    "base_revision", "next_revision", "input_sha256", "output_sha256",
    "writer", "verification", "edit_plan", "structure"
  ],
  "properties": {
    "input_source": {"$ref": "#/$defs/fileName"},
    "output_source": {"$ref": "#/$defs/fileName"},
    "input_file_size": {"$ref": "#/$defs/decimal"},
    "output_file_size": {"$ref": "#/$defs/decimal"},
    "base_revision": {"$ref": "#/$defs/decimal"},
    "next_revision": {"$ref": "#/$defs/decimal"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "writer": {"$ref": "#/$defs/writer"},
    "verification": {"$ref": "#/$defs/verification"},
    "edit_plan": {"$ref": "#/$defs/editPlan"},
    "structure": {"$ref": "#/$defs/editStructure"}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "fileName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "nullableDecimal": {
      "oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]
    },
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compressed_bytes", "inflated_bytes", "crc32"],
      "properties": {
        "compressed_bytes": {"$ref": "#/$defs/decimal"},
        "inflated_bytes": {"$ref": "#/$defs/decimal"},
        "crc32": {"$ref": "#/$defs/decimal"}
      }
    },
    "firstBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_block", "kind", "hlit", "hdist", "hclen", "window_ok"],
      "properties": {
        "final_block": {"type": "boolean"},
        "kind": {"enum": ["stored", "fixed", "dynamic"]},
        "hlit": {"type": ["integer", "null"], "minimum": 0},
        "hdist": {"type": ["integer", "null"], "minimum": 0},
        "hclen": {"type": ["integer", "null"], "minimum": 0},
        "window_ok": {"type": "boolean"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "file_size", "input_sha256", "header_ok", "magic_ok", "header_len",
        "stream_start", "stream_end", "footer_offset", "footer_crc", "computed_crc",
        "footer_size", "computed_size", "footer_crc_ok", "footer_size_ok", "inflate_ok",
        "inflated", "compressed_bytes", "window_ok", "first_block"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/fileName"},
        "file_size": {"$ref": "#/$defs/decimal"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "header_ok": {"type": "boolean"},
        "magic_ok": {"type": "boolean"},
        "header_len": {"$ref": "#/$defs/decimal"},
        "stream_start": {"$ref": "#/$defs/decimal"},
        "stream_end": {"$ref": "#/$defs/decimal"},
        "footer_offset": {"$ref": "#/$defs/decimal"},
        "footer_crc": {"$ref": "#/$defs/decimal"},
        "computed_crc": {"$ref": "#/$defs/decimal"},
        "footer_size": {"$ref": "#/$defs/decimal"},
        "computed_size": {"$ref": "#/$defs/decimal"},
        "footer_crc_ok": {"type": "boolean"},
        "footer_size_ok": {"type": "boolean"},
        "inflate_ok": {"type": "boolean"},
        "inflated": {"$ref": "#/$defs/decimal"},
        "compressed_bytes": {"$ref": "#/$defs/decimal"},
        "window_ok": {"type": "boolean"},
        "window_proof": {"oneOf": [{"const": "first_block"}, {"const": "stored"}, {"type": "object", "additionalProperties": false, "required": ["decoded"], "properties": {"decoded": {"type": "object", "additionalProperties": false, "required": ["max_distance"], "properties": {"max_distance": {"type": "integer", "minimum": 0, "maximum": 4096}}}}}]},
        "first_block": {"$ref": "#/$defs/firstBlock"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraph_id", "status", "reason", "source_text_sha256",
        "replacement_sha256", "source_bytes", "replacement_bytes"
      ],
      "properties": {
        "paragraph_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["ready", "skipped"]},
        "reason": {
          "type": ["string", "null"],
          "enum": [
            "paragraph_not_found", "duplicate_paragraph_id", "preview_truncated",
            "multiline_unsupported", "hidden_controls_unsupported", "source_mismatch",
            "cp949_unrepresentable", "byte_length_changed", "image_marker_changed", null
          ]
        },
        "source_text_sha256": {"$ref": "#/$defs/nullableSha256"},
        "replacement_sha256": {"$ref": "#/$defs/sha256"},
        "source_bytes": {"$ref": "#/$defs/nullableDecimal"},
        "replacement_bytes": {"$ref": "#/$defs/nullableDecimal"}
      }
    },
    "editPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "base_revision", "operation_count", "ready", "skipped", "decisions"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/fileName"},
        "base_revision": {"$ref": "#/$defs/decimal"},
        "operation_count": {"type": "integer", "minimum": 0, "maximum": 500},
        "ready": {"type": "integer", "minimum": 0, "maximum": 500},
        "skipped": {"type": "integer", "minimum": 0, "maximum": 500},
        "decisions": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/decision"}}
      }
    },
    "editStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_equal", "inflated_size_equal", "summary_equal", "fixed_blocks_equal",
        "target_paragraphs_equal", "non_target_paragraphs_equal", "body_changed"
      ],
      "properties": {
        "header_equal": {"type": "boolean"},
        "inflated_size_equal": {"type": "boolean"},
        "summary_equal": {"type": "boolean"},
        "fixed_blocks_equal": {"type": "boolean"},
        "target_paragraphs_equal": {"type": "boolean"},
        "non_target_paragraphs_equal": {"type": "boolean"},
        "body_changed": {"type": "boolean"}
      }
    }
  }
}
