{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seoan:contracts:repack-v1",
  "title": "Seoan HLT Phase 4A no-clobber repack result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_source", "output_source", "input_file_size", "output_file_size",
    "input_sha256", "output_sha256", "writer", "verification", "structural_parity"
  ],
  "properties": {
    "input_source": {"$ref": "#/$defs/fileName"},
    "output_source": {"$ref": "#/$defs/fileName"},
    "input_file_size": {"$ref": "#/$defs/decimal"},
    "output_file_size": {"$ref": "#/$defs/decimal"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "writer": {"$ref": "#/$defs/writer"},
    "verification": {"$ref": "#/$defs/verification"},
    "structural_parity": {"$ref": "#/$defs/structuralParity"}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "fileName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compressed_bytes", "inflated_bytes", "crc32"],
      "properties": {
        "compressed_bytes": {"$ref": "#/$defs/decimal"},
        "inflated_bytes": {"$ref": "#/$defs/decimal"},
        "crc32": {"$ref": "#/$defs/decimal"}
      }
    },
    "structuralParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_equal", "inflated_equal", "summary_equal", "fixed_blocks_equal"],
      "properties": {
        "header_equal": {"type": "boolean"},
        "inflated_equal": {"type": "boolean"},
        "summary_equal": {"type": "boolean"},
        "fixed_blocks_equal": {"type": "boolean"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "file_size", "input_sha256", "header_ok", "magic_ok", "header_len",
        "stream_start", "stream_end", "footer_offset", "footer_crc", "computed_crc",
        "footer_size", "computed_size", "footer_crc_ok", "footer_size_ok", "inflate_ok",
        "inflated", "compressed_bytes", "window_ok", "first_block"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/fileName"},
        "file_size": {"$ref": "#/$defs/decimal"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "header_ok": {"type": "boolean"},
        "magic_ok": {"type": "boolean"},
        "header_len": {"$ref": "#/$defs/decimal"},
        "stream_start": {"$ref": "#/$defs/decimal"},
        "stream_end": {"$ref": "#/$defs/decimal"},
        "footer_offset": {"$ref": "#/$defs/decimal"},
        "footer_crc": {"$ref": "#/$defs/decimal"},
        "computed_crc": {"$ref": "#/$defs/decimal"},
        "footer_size": {"$ref": "#/$defs/decimal"},
        "computed_size": {"$ref": "#/$defs/decimal"},
        "footer_crc_ok": {"type": "boolean"},
        "footer_size_ok": {"type": "boolean"},
        "inflate_ok": {"type": "boolean"},
        "inflated": {"$ref": "#/$defs/decimal"},
        "compressed_bytes": {"$ref": "#/$defs/decimal"},
        "window_ok": {"type": "boolean"},
        "window_proof": {"oneOf": [{"const": "first_block"}, {"const": "stored"}, {"type": "object", "additionalProperties": false, "required": ["decoded"], "properties": {"decoded": {"type": "object", "additionalProperties": false, "required": ["max_distance"], "properties": {"max_distance": {"type": "integer", "minimum": 0, "maximum": 4096}}}}}]},
        "first_block": {"$ref": "#/$defs/firstBlock"}
      }
    },
    "firstBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_block", "kind", "hlit", "hdist", "hclen", "window_ok"],
      "properties": {
        "final_block": {"type": "boolean"},
        "kind": {"enum": ["stored", "fixed", "dynamic"]},
        "hlit": {"type": ["integer", "null"], "minimum": 0},
        "hdist": {"type": ["integer", "null"], "minimum": 0},
        "hclen": {"type": ["integer", "null"], "minimum": 0},
        "window_ok": {"type": "boolean"}
      }
    }
  }
}
